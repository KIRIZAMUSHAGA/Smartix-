import React, { useState, useEffect, useRef } from 'react';
import { resolvePostLayout, PostLayouts } from '../utils/postLayoutResolver';
import { Heart, MessageCircle, Repeat, Bookmark, MoreHorizontal } from 'lucide-react';
import PostCardShell from './layouts/PostCardShell';
import PostTextPlain from './layouts/PostTextPlain';
import PostTextWithBackground from './layouts/PostTextWithBackground';
import PostImage from './layouts/PostImage';
import PostBgLayer from './PostBgLayer';

/**
 * AdaptivePostCard - Version Architecture Facebook
 * Ce composant est maintenant un pur ROUTEUR de rendu.
 */
const AdaptivePostCard = ({ post, user, onLike, onComment, onShare }) => {
  const [isExpanded, setIsExpanded] = useState(false);
  const [isImageVisible, setIsImageVisible] = useState(false);
  const cardRef = useRef(null);
  
  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          setIsImageVisible(true);
          observer.disconnect();
        }
      },
      { rootMargin: '100px' }
    );

    if (cardRef.current) {
      observer.observe(cardRef.current);
    }

    return () => observer.disconnect();
  }, []);

  if (!post) return null;

  const layout = resolvePostLayout(post);
  const hasBgCss = !!post.background_css;
  const hasBgImg = !!post.background_image;
  const isStyledBackground = hasBgCss || hasBgImg;

  // DIAGNOSTIC LOG
  useEffect(() => {
    if (isStyledBackground) {
      console.log(`🎨 [AdaptivePostCard] Post ${post.id} detected as STYLED:`, {
        background_css: post.background_css,
        background_image: post.background_image,
        isStyledBackground
      });
    }
  }, [post.id, post.background_css, post.background_image, isStyledBackground]);

  const getAvatarUrl = (avatar) => {
    if (!avatar) return '/default-avatar.png';
    if (avatar.startsWith('http')) return avatar;
    let filename = avatar.includes('/') ? avatar.split('/').pop() : avatar;
    const API_BASE_URL = process.env.REACT_APP_API_URL || '';
    return `${API_BASE_URL}/uploads/avatars/${filename}`;
  };

  const formatTimeAgo = (dateString) => {
    if (!dateString) return '';
    try {
      const date = new Date(dateString);
      const now = new Date();
      const diffInSeconds = Math.floor((now - date) / 1000);
      if (diffInSeconds < 60) return `il y a ${diffInSeconds}s`;
      const diffInMinutes = Math.floor(diffInSeconds / 60);
      if (diffInMinutes < 60) return `il y a ${diffInMinutes} min`;
      const diffInHours = Math.floor(diffInMinutes / 60);
      if (diffInHours < 24) return `il y a ${diffInHours}h`;
      return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    } catch (e) { return ''; }
  };

  const renderHeader = () => (
    <div className={`flex items-center justify-between p-5 pb-2 relative z-20 ${!isStyledBackground ? 'bg-white' : ''}`}>
      <div className="flex items-center">
        <div className="w-12 h-12 rounded-full border-2 overflow-hidden shadow-md border-white bg-gray-50">
          <img 
            src={getAvatarUrl(post.author?.avatar)} 
            alt="" 
            className="w-full h-full object-cover"
            onError={(e) => { e.currentTarget.src = "/default-avatar.png"; }}
          />
        </div>
        <div className="ml-3">
          <h4 className={`text-[16px] font-black leading-tight ${isStyledBackground ? 'text-white drop-shadow-md' : 'text-gray-900'}`}>
            {post.author?.full_name || 'Utilisateur'}
          </h4>
          <div className="flex items-center gap-1.5 mt-0.5">
            <span className={`text-[11px] font-bold ${isStyledBackground ? 'text-white/80' : 'text-gray-400'}`}>
              {formatTimeAgo(post.created_at)}
            </span>
            <span className={`text-[11px] font-black flex items-center gap-1 ${isStyledBackground ? 'text-white' : 'text-indigo-500'}`}>
               • 🎓 {post.category || 'Général'}
            </span>
          </div>
        </div>
      </div>
      <button className={`${isStyledBackground ? 'text-white/50 hover:text-white' : 'text-gray-300 hover:text-gray-500'} transition-colors p-1`}>
        <MoreHorizontal size={22} />
      </button>
    </div>
  );

  const renderActions = () => (
    <div className={`flex items-center justify-between px-4 py-4 border-t border-gray-50 ${!isStyledBackground ? 'bg-white' : ''}`}>
      <div className="flex items-center gap-3">
        <button onClick={(e) => { e.stopPropagation(); onLike?.(); }} className={`flex items-center gap-1 font-black text-[13px] ${post.likedByCurrentUser ? 'text-[#ff4b6b]' : 'text-gray-400'}`}>
          <Heart size={18} fill={post.likedByCurrentUser ? "#ff4b6b" : "none"} />
          <span>Utile</span>
          <span className="text-gray-300">{post.likes?.length || 0}</span>
        </button>
        <button onClick={(e) => { e.stopPropagation(); onComment?.(); }} className="flex items-center gap-1 font-black text-[13px] text-[#4c6ef5]">
          <MessageCircle size={18} />
          <span>Répondre</span>
        </button>
      </div>
      <div className="flex items-center gap-3">
        <button onClick={(e) => { e.stopPropagation(); onShare?.(); }} className="flex items-center gap-1 font-black text-[13px] text-gray-500">
          <Repeat size={18} />
          <span>Relayer</span>
        </button>
        <button onClick={(e) => { e.stopPropagation(); alert("Sauvegardé !"); }} className="flex items-center gap-1 font-black text-[13px] text-[#7950f2]">
          <Bookmark size={18} />
          <span>Sauver</span>
        </button>
      </div>
    </div>
  );

  const getBackgroundStyle = () => {
    if (post.background_css) return { background: post.background_css };
    if (post.background_image) return {
      backgroundImage: `url(${post.background_image})`,
      backgroundSize: 'cover',
      backgroundPosition: 'center'
    };
    return null;
  };

  // ROUTAGE DE RENDU STRICT
  const renderLayout = () => {
    // Si c'est un post immersif (TEXT_BACKGROUND)
    if (isStyledBackground && !post.image) {
      return (
        <div className="relative overflow-hidden rounded-[32px] min-h-[350px] flex flex-col">
          <PostBgLayer post={post} />
          <PostTextWithBackground content={post.content} backgroundStyle={getBackgroundStyle()} />
        </div>
      );
    }

    if (layout === PostLayouts.IMAGE_BACKGROUND || post.image) {
      return <PostImage post={post} isImageVisible={isImageVisible} cardRef={cardRef} />;
    }
    
    return <PostTextPlain content={post.content} />;
  };

  return (
    <PostCardShell 
      header={renderHeader()} 
      footer={renderActions()}
    >
      {renderLayout()}
    </PostCardShell>
  );
};

export default AdaptivePostCard;

