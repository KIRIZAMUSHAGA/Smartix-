import React from 'react';

const PostCardShell = ({ children, header, footer }) => {
  return (
    <div className="mb-6 mx-2 rounded-[32px] border border-gray-100 shadow-[0_10px_30px_rgba(0,0,0,0.04)] overflow-hidden transition-all duration-300 relative">
      {/* Structure fixe du Header */}
      {header}
      
      {/* Zone de contenu flexible (les layouts de l'étape 1) */}
      <div className="w-full relative">
        {children}
      </div>

      {/* Structure fixe du Footer */}
      {footer}
    </div>
  );
};

export default PostCardShell;
