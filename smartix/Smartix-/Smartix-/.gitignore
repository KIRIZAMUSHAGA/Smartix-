**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Fichiers volumineux à ne pas commiter
attached_assets/*.png
attached_assets/*.jpg
frontend/build/
frontend/node_modules/.cache/

