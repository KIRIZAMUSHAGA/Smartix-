/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
.pythonlibs/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*token.json*
*credentials.json*

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/

