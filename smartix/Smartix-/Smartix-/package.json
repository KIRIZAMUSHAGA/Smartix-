{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Plateforme complète avec système de like/super-like universel.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn server:app --reload",
    "dev:frontend": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && pip install -r requirements.txt",
    "build:frontend": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && python -m uvicorn server:app",
    "start:frontend": "cd frontend && npm start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate-vapid": "web-push generate-vapid-keys"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.20",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.9",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.53.0",
    "prettier": "^3.1.0",
    "typescript": "^5.2.2",
    "web-push": "^3.6.0"
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@craco/craco": "^7.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "dompurify": "^3.3.3",
    "lodash.throttle": "^4.1.1",
    "lz-string": "^1.5.0",
    "p-queue": "^9.1.1",
    "react-virtual": "^2.10.4"
  }
}
