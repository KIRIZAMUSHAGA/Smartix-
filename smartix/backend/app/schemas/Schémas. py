from pydantic import BaseModel
from typing import Optional
from datetime import datetime

class NewsBase(BaseModel):
    title: str
    summary: Optional[str] = None
    url: str
    image_url: Optional[str] = None
    source: Optional[str] = None
    published_at: Optional[datetime] = None
    category: Optional[str] = None

class NewsOut(NewsBase):
    id: int
    fetched_at: Optional[datetime] = None
    is_duplicate: bool = False

    class Config:
        orm_mode = True

class LikeIn(BaseModel):
    user_id: str

class CoursePage(BaseModel):
    id: str
    title: str
    content: str
    order: int

class CourseBase(BaseModel):
    title: str
    description: Optional[str] = None
    coverImage: Optional[str] = None
    author: Optional[str] = None
    category: Optional[str] = "informatique"
    level: Optional[str] = "débutant"
    status: Optional[str] = "draft"
    pages: Optional[list[CoursePage]] = []
    aiStatus: Optional[str] = "idle"  # idle | analyzing | done
    aiSummary: Optional[str] = None

class CourseCreate(CourseBase):
    pass

class CourseFileBase(BaseModel):
    courseId: str
    fileUrl: str
    fileType: str  # pdf, doc, image, autre
    mimeType: Optional[str] = None
    size: Optional[int] = None
    originalFilename: Optional[str] = None
    createdAt: datetime

class CourseFileOut(CourseFileBase):
    id: str

    class Config:
        orm_mode = True
