modules = ["nodejs-20", "python-3.11", "web", "bash"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0"]
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-main"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Main_App_Frontend_v2"

[[workflows.workflow]]
name = "backend-main"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/backend && PYTHONPATH=/home/runner/workspace/backend /home/runner/workspace/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "Main_App_Frontend_v2"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/frontend && PORT=5000 SKIP_PREFLIGHT_CHECK=true DANGEROUSLY_DISABLE_HOST_CHECK=true ESLINT_NO_DEV_ERRORS=true node_modules/.bin/craco start"
waitForPort = 5000

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "xcodebuild", "zlib"]

[userenv]

[userenv.shared]
PYTHONPATH = "/home/runner/workspace/backend"
MONITORING_ENABLED = "false"
