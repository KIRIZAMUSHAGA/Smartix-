modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Smartix Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Smartix Backend"

[[workflows.workflow]]
name = "Smartix Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/smartix/frontend && PORT=5000 SKIP_PREFLIGHT_CHECK=true DANGEROUSLY_DISABLE_HOST_CHECK=true ESLINT_NO_DEV_ERRORS=true npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Smartix Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/smartix/backend && PYTHONPATH=/home/runner/workspace/smartix/backend:/home/runner/workspace/.pythonlibs python -m uvicorn server:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
